{
  // Localhost binding (required for security)
  "listen": "127.0.0.1:8787",
  
  // Default cooldown if no Retry-After header is sent
  "default_cooldown_seconds": 60,
  
  "providers": [
    {
      "name": "openrouter",
      "base_url": "https://openrouter.ai/api",
      "auth_style": "bearer",
      "tier": 0,
      "override_model": "recursive/flint-v1.0:free",
      "extra_headers": {
        "HTTP-Referer": "http://localhost:8787",
        "X-Title": "My Claude Router"
      },
      "keys": [
        "sk-or-v1-REPLACE_ME"
      ]
    },
    {
      "name": "tokenharbor",
      "base_url": "https://api.tokenharbor.com",
      "auth_style": "x-api-key",
      "tier": 1,
      "override_model": "deepseek/deepseek-v4.1-flash",
      "cooldown_seconds": 120,
      "keys": [
        "th-REPLACE_ME"
      ]
    }
  ]
}
